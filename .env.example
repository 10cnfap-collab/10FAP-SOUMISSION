# --- Copiez ces variables dans Vercel › Project › Settings › Environment Variables ---

# Mot de passe de l'espace Administration (obligatoire)
ADMIN_PASSWORD=
# Chaîne aléatoire longue pour signer les sessions admin (recommandé)
SESSION_SECRET=

# Base de données : ajoutée AUTOMATIQUEMENT quand vous connectez Upstash Redis
# (Vercel › Storage › Upstash for Redis). Ne rien saisir à la main.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- E-mails : option 1, SMTP (Gmail, Outlook, hébergeur du domaine…) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=congres.fap@gmail.com
SMTP_PASS=
MAIL_FROM="Comité scientifique – 10ème Congrès FAP <congres.fap@gmail.com>"
# Adresse de réponse (facultatif)
MAIL_REPLY_TO=

# --- E-mails : option 2, Resend (remplace SMTP si renseigné) ---
# RESEND_API_KEY=
# MAIL_FROM="Comité scientifique <congres@votre-domaine.dz>"

# Adresse publique du site, utilisée pour le logo dans les e-mails (facultatif)
# SITE_URL=https://resumes-fap.vercel.app
